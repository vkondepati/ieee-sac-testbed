	column iso_week_year
		dataType: int64
		formatString: 0
		sourceProviderType: int
		lineageTag: 3445d22d-1a2b-42be-894e-adfac8a39108
		sourceLineageTag: iso_week_year
		summarizeBy: sum
		sourceColumn: iso_week_year

