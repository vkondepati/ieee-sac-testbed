# Databricks SQL
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# Use either a personal access token or OAuth M2M credentials.
DATABRICKS_ACCESS_TOKEN=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=sac_conformance
DATABRICKS_TABLE=sac_fact
DATABRICKS_METRIC_VIEW=sac_metrics

# Snowflake
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=SAC_CONFORMANCE
SNOWFLAKE_TABLE=SAC_FACT
SNOWFLAKE_SEMANTIC_VIEW=SAC_METRICS
SNOWFLAKE_ROLE=

# Microsoft Fabric / Power BI semantic model

# Microsoft Fabric authentication. azure_cli is easiest for a personal/trial test.
FABRIC_AUTH_MODE=azure_cli
# For azure_cli: install Azure CLI and run `az login`; client/secret are not needed.
# For service_principal: set FABRIC_AUTH_MODE=service_principal and fill the fields below.
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE_ID=
FABRIC_SEMANTIC_MODEL_ID=
FABRIC_TABLE_NAME=SaCFact
# The Fabric semantic model must already contain the canonical fixture table named above.
# Set to true only after reviewing the generated TMDL patch.
FABRIC_APPLY_TMDL=false

# Optional governance tests
FABRIC_IMPERSONATED_UPN=
